{
  "kind": "collectionType",
  "collectionName": "authors",
  "info": {
    "singularName": "author",
    "pluralName": "authors",
    "displayName": "Autori"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "mapColor": {
      "type": "customField",
      "customField": "global::map-color",
      "regex": "^#[0-9A-Fa-f]{6}$"
    },
    "mapEffect": {
      "type": "enumeration",
      "enum": [
        "none",
        "pulse",
        "ring"
      ],
      "default": "none"
    },
    "bio": {
      "type": "text"
    },
    "bio_en": {
      "type": "text"
    },
    "bio_tr": {
      "type": "text"
    },
    "bio_fr": {
      "type": "text"
    },
    "bio_de": {
      "type": "text"
    },
    "bio_es": {
      "type": "text"
    },
    "bio_el": {
      "type": "text"
    },
    "bio_ar": {
      "type": "text"
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "email": {
      "type": "email"
    },
    "socials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social"
    },
    "publicProfile": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::team-member.team-member"
    }
  }
}
